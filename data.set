   "metadata": {},
   "outputs": [],
   "source": [
    "# listed_in (type) coloum to identify popular restaurant categories.\n",
    "sns.countplot(x=dataframe['listed_in(type)'])\n",
    "plt.xlabel(\"type of restaurant\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8414428f-540d-471a-9b91-d2e33ed52ca8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# votes by restaurant Type\n",
    "grouped_data = dataframe.groupby('listed_in(type)')['votes'].sum()\n",
    "result = pd.DataFrame({'votes':grouped_data})\n",
    "plt.plot(result, c='green',marker='o')\n",
    "plt.xlabel('Type of restaurant')\n",
    "plt.ylabel('Votes')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
